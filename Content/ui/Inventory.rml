<rml>

    <head>
        <title>Inventory</title>

        <style>
            body {
                width: 100%;
                height: 100%;
                display: flex;
                flex-direction: column;
                justify-content: flex-end;
                align-items: center;
                font-family: LatoLatin;
            }

            #inventory_bar {
                display: flex;
                flex-direction: row;
                flex-grow: 0;
                flex-shrink: 0;
                align-items: flex-start;
                margin-bottom: 20dp;
                border-color: aqua;
                width: 522dp;
                height: 56dp;
            }

            .icon {
                width: 56dp;
                height: 56dp;
                flex-grow: 0;
                flex-shrink: 0;
                border-color: transparent;
                margin-right: 2dp;
                decorator: image("InvSlot.png");
                image-color: rgba(255, 255, 255, 191);
            }

            .icon:last-child {
                margin-right: 0dp;
            }

            .icon.selected {
                border-color: yellow;
            }
        </style>
    </head>

    <body>
        <div id="inventory_bar">
            <div class="icon" id="slot_1"></div>
            <div class="icon" id="slot_2"></div>
            <div class="icon" id="slot_3"></div>
            <div class="icon" id="slot_4"></div>
            <div class="icon" id="slot_5"></div>
            <div class="icon" id="slot_6"></div>
            <div class="icon" id="slot_7"></div>
            <div class="icon" id="slot_8"></div>
            <div class="icon" id="slot_9"></div>
        </div>
    </body>

</rml>