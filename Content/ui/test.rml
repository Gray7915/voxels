    <rml>
    <head>
    <title>Test</title>
    <style>
    body {
    width: 100%;
    height: 100%;

    font-family: LatoLatin;
    font-size: 48dp;
    color: white;
}

    .hotbar {
        position: absolute;
        bottom: 20dp;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        flex-direction: row;
    }

   .slot {
    width: 48dp;
    height: 48dp;
    background: red;
}

    .slot.selected {
        border-color: #ffffff;
        border-width: 3dp;
    }

    .slot img {
        width: 40dp;
        height: 40dp;
        margin: 4dp;
    }
    </style>
    </head>
    <body>
    <div>Hello RmlUi</div>
    <div class="hotbar" id="hotbar">
        <div class="slot" id="slot1">Slot1</div>
    </div>
    </body>
    </rml>