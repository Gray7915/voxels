<rml>

    <head id="head">
        <title>Inventory Window</title>
        <style>
            body {
                width: 100%;
                height: 100%;
                font-family: LatoLatin;

            }

            .inventory-window {
                position: absolute;
                width: 522dp;
                /* content width: 9 x 58dp */
                height: 600dp;
                top: 50%;
                left: 50%;
                margin-left: -283dp;
                /* half of (522 + 2*20 padding + 2*2 border) = 566 */
                margin-top: -300dp;
                background-color: rgba(30, 30, 30, 220);
                border-width: 2dp;
                border-color: #888;
                padding: 20dp;
            }

            .icon {
                width: 56dp;
                min-width: 56dp;
                max-width: 56dp;
                height: 56dp;
                min-height: 56dp;
                max-height: 56dp;
                flex-grow: 0;
                flex-shrink: 0;
                border-color: transparent;
                margin-right: 2dp;
                border-width: 2dp;
                decorator: image("InvSlot.png");
                image-color: rgba(255, 255, 255, 191);
                position: relative
            }

            .icon:last-child {
                margin-right: 0dp;
            }

            .icon.selected {
                border-color: rgb(0, 136, 255);
                border-radius: 20dp;
            }

            .slot {
                position: relative;
                /* so the count can be positioned against the slot */
            }

            .inventory-title {
                font-size: 28dp;
                color: white;
                margin-bottom: 20dp;
                text-align: center;
            }

            .item-list {
                display: flex;
                flex-direction: row;
                flex-wrap: wrap;
                width: 100%;
                overflow-y: auto;
                /* scroll if there are more rows than fit */
                height: 520dp;
                /* leave room for the title */
            }

            .slot-cell {
                width: 56dp;
                height: 56dp;
                margin-right: 2dp;
                margin-bottom: 2dp;
                flex-grow: 0;
                flex-shrink: 0;
                decorator: image("InvSlot.png");
                image-color: rgba(255, 255, 255, 191);
                box-sizing: border-box;
            }

            .slot-cell {
                /* ensures that the text is positioned correctly*/
                position: relative;
                width: 56dp;
                height: 56dp;
                margin-right: 2dp;
                margin-bottom: 2dp;
                flex-grow: 0;
                flex-shrink: 0;
                decorator: image("InvSlot.png");
                image-color: rgba(255, 255, 255, 191);
                box-sizing: border-box;
            }

            .slot-cell:hover {
                image-color: rgba(255, 255, 255, 255);
            }

            .item-row {
                width: 100%;
                height: 50dp;
                background-color: rgba(60, 60, 60, 200);
                border-width: 1dp;
                border-color: #555;
                margin-bottom: 4dp;
                padding: 10dp;
                box-sizing: border-box;
                color: white;
                font-size: 22dp;
            }

            .item-row:hover {
                background-color: rgba(100, 100, 100, 200);
            }

            .item-row:active {
                background-color: rgba(40, 40, 40, 200);
            }

            .slot-img-container {
                position: relative;
                width: 48dp;
                height: 48dp;
                margin: 4dp;
                drag: clone;
            }

            .slot-img {
                width: 48dp;
                height: 48dp;
            }

            .count {
                position: absolute;
                right: 2dp;
                bottom: 0dp;
                font-size: 18dp;
                font-weight: bold;
                color: white;
                text-shadow: 1dp 1dp 0 black;
                pointer-events: none;
            }
        </style>
    </head>

    <body data-model="items" id="body">
        <div class="inventory-window" id="window div">

            <div class="inventory-title" id="title">
                Items
            </div>
            <div class="item-list" id="itemList">
                <div class="slot-cell" data-for="item : items" data-attr-id="item.id">
                    <div class="slot-img-container">
                        <img class="slot-img" data-attr-src="item.img" />
                        <div class="count">64</div>
                    </div>
                </div>
            </div>
        </div>
    </body>
</rml>